// Tests for the Subscription workflow (subscription.orbit).
//
// Run them with `orbit test examples/subscription.test.orbit`. Simulated time
// jumps over each 30-day wait, and `expect` checks the final run.

import "subscription.orbit"

test "three periods are three runs" {
    workflow Subscription
    input { customer_id: "c-1", amount: 9.5, periods: 3 }
    mock "payments.charge" returns { transaction_id: "tx-" + input.order_id, status: "captured" }
    mock "notifications.send" returns { delivered: true }
    expect status COMPLETED
    expect runs 3
    expect output { periods: 3, charged: 28.5 }
    expect step charge output { transaction_id: "tx-c-1-3" }
}

test "a single period completes in the first run" {
    workflow Subscription
    input { customer_id: "c-2", amount: 20.0, periods: 1 }
    mock "payments.charge" returns { transaction_id: "tx-1", status: "captured" }
    mock "notifications.send" returns { delivered: true }
    expect runs 1
    expect output { periods: 1, charged: 20.0 }
}

test "a declined charge ends the subscription in that period" {
    workflow Subscription
    input { customer_id: "c-3", amount: 5.0, periods: 6 }
    // The first period is paid; the second is declined.
    mock "payments.charge" returns { transaction_id: "tx-1", status: "captured" } times 1 then fails "CARD_DECLINED" "insufficient funds"
    mock "notifications.send" returns { delivered: true }
    expect status FAILED
    expect error "CARD_DECLINED"
    expect runs 2
}
