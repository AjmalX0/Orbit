{
  "name": "orbit-lang",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript worker SDK for the ORBIT orchestration runtime",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/worker.test.ts",
    "prepack": "tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AjmalX0/Orbit.git",
    "directory": "sdks/typescript"
  },
  "homepage": "https://github.com/AjmalX0/Orbit/tree/main/sdks/typescript",
  "bugs": {
    "url": "https://github.com/AjmalX0/Orbit/issues"
  },
  "keywords": [
    "orbit",
    "workflow",
    "orchestration",
    "durable-execution",
    "saga",
    "worker"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
