(* ORBIT grammar: the language accepted by orbit-syntax 0.2.0.
   Notation: ISO EBNF. { x } = zero or more, [ x ] = optional.

   Lexical notes
   - Keywords are contextual: every word lexes as IDENTIFIER and the parser
     treats it as a keyword only in keyword position. `input`, `version`,
     `status` ... remain valid field names. Only true/false/null are reserved.
   - Whitespace and newlines are insignificant, with one rule: an infix
     operator (and a postfix `[`, `.` or `(`) must be on the same line as its
     left operand. `{ a: 1  b: -2 }` therefore has two fields.
   - Separators `,` and `;` between members, fields and list items are optional.
   - Member keywords may be followed by an optional `:`
     (`timeout 5s` == `timeout: 5s`). *)

program          = { declaration } ;
declaration      = workflow_decl | schema_decl | task_decl | import_decl | test_decl ;

import_decl      = "import" , STRING ;                     (* path relative to the importing file *)

schema_decl      = "schema" , IDENTIFIER , record_body ;
record_body      = "{" , { field , [ sep ] } , "}" ;
field            = IDENTIFIER , ":" , type , [ "=" , expression ] ;   (* default must be constant *)

task_decl        = "task" , STRING , "{" , { task_member , [ sep ] } , "}" ;
task_member      = "version" , [ ":" ] , STRING
                 | "description" , [ ":" ] , STRING
                 | "input" , [ ":" ] , type
                 | "output" , [ ":" ] , type
                 | "compensated_by" , [ ":" ] , STRING ;        (* the task that undoes this one *)

workflow_decl    = "workflow" , IDENTIFIER , "{" , { workflow_member , [ sep ] } , "}" ;
workflow_member  = "version" , [ ":" ] , STRING
                 | "description" , [ ":" ] , STRING
                 | "timeout" , [ ":" ] , DURATION
                 | "input" , record_body
                 | "output" , record_body
                 | step_decl
                 | "signal" , IDENTIFIER , record_body           (* typed message the execution accepts *)
                 | "query" , IDENTIFIER , [ "=" | ":" ] , expression   (* read-only view; written with "=" *)
                 | "return" , expression
                 | "on" , ( "failure" | "cancel" | "timeout" ) , "{" , { step_decl , [ sep ] } , "}" ;
                   (* outcome handler: at most one block per kind (E0319); other
                      kinds are rejected (E0105). Handler steps take a worker,
                      compute or sleep action; no await, child workflow, for,
                      max_parallel or compensate (E0307, E0308); `after` names
                      steps of the same block (E0303). *)

step_decl        = "step" , IDENTIFIER , "{" , { step_member , [ sep ] } , "}" ;
step_member      = action
                 | "using" , [ ":" ] , IDENTIFIER
                 | "after" , [ ":" ] , IDENTIFIER , { "," , IDENTIFIER }
                 | "with" , [ ":" ] , expression
                 | "timeout" , [ ":" ] , DURATION                (* per attempt, start-to-close *)
                 | "queue_timeout" , [ ":" ] , DURATION          (* time allowed waiting for a worker *)
                 | "retry" , "{" , { IDENTIFIER , ":" , expression , [ sep ] } , "}"
                 | "idempotency_key" , [ ":" ] , expression
                 | "when" , [ ":" ] , expression
                 | "for" , IDENTIFIER , "in" , expression        (* fan out over a list *)
                 | "max_parallel" , [ ":" ] , INTEGER            (* only with `for` *)
                 | "compensate" , "{" , { step_member , [ sep ] } , "}" ;
action           = "worker" , [ ":" ] , STRING                   (* a task contract name *)
                 | "workflow" , [ ":" ] , STRING                 (* a child workflow name *)
                 | "sleep" , [ ":" ] , DURATION
                 | "await" , [ ":" ] , IDENTIFIER                (* a signal declared in the workflow *)
                 | "compute" , [ ":" ] , expression ;            (* evaluated by the runtime *)
(* Restrictions checked by the compiler (see docs/src/reference/diagnostics.md):
   - `workflow` steps take no `using`, `retry`, `idempotency_key` or `queue_timeout` (E0307);
   - `compensate` blocks call a `worker` and take no `when`, `after`, `for` or `max_parallel`;
   - `for` is not allowed on `sleep` steps; the loop variable is in scope in `with`,
     `idempotency_key` and `compensate`, but not in `when` (evaluated once per step);
   - `await` steps take only `after`, `when` and `timeout`; `compute` steps take only
     `after`, `when`, `for` and `max_parallel`; neither takes `compensate` (E0307, E0308). *)

(* retry settings: attempts: INTEGER, backoff: fixed | exponential,
   initial_delay: DURATION, max_delay: DURATION, non_retryable: [STRING, ...] *)

type             = base_type , { "?" } ;
base_type        = "List" , "<" , type , ">"
                 | "Map" , "<" , type , "," , type , ">"       (* key must be String *)
                 | record_body                                  (* anonymous record *)
                 | IDENTIFIER ;                                 (* primitive or schema name *)
(* primitives: String Int Float Bool Bytes Duration Timestamp UUID JSON *)

expression       = or_expr ;
or_expr          = and_expr , { "||" , and_expr } ;
and_expr         = eq_expr , { "&&" , eq_expr } ;
eq_expr          = cmp_expr , { ( "==" | "!=" ) , cmp_expr } ;
cmp_expr         = add_expr , { ( "<" | "<=" | ">" | ">=" ) , add_expr } ;
add_expr         = mul_expr , { ( "+" | "-" ) , mul_expr } ;
mul_expr         = unary , { ( "*" | "/" | "%" ) , unary } ;
unary            = ( "!" | "-" ) , unary | postfix ;
postfix          = primary , { "." , IDENTIFIER | "[" , expression , "]" } ;
primary          = literal
                 | IDENTIFIER , "(" , [ argument , { "," , argument } ] , ")"   (* built-in call *)
                 | IDENTIFIER                                    (* path root: input | execution | step | loop variable *)
                 | "{" , { ( IDENTIFIER | STRING ) , ":" , expression , [ sep ] } , "}"
                 | "[" , [ expression , { [ "," ] , expression } ] , "]"   (* items: "," or newline, not ";" *)
                 | "if" , expression , "then" , expression , "else" , expression
                 | "(" , expression , ")" ;
argument         = IDENTIFIER , "=>" , expression                (* lambda: only as argument 2 of map, filter, find, any, all (E0415) *)
                 | expression ;
literal          = STRING | INTEGER | FLOAT | DURATION | "true" | "false" | "null" ;
block            = "{" , { ANY_TOKEN | block } , "}" ;
sep              = "," | ";" ;

(* Tokens *)
IDENTIFIER       = ( letter | "_" ) , { letter | digit | "_" } ;
INTEGER          = digit , { digit | "_" } ;                    (* signed 64-bit *)
FLOAT            = digit , { digit | "_" } , "." , digit , { digit | "_" } ;
DURATION         = ( INTEGER | FLOAT ) , ( "ms" | "s" | "m" | "h" | "d" ) ;
STRING           = '"' , { char | escape } , '"' ;              (* single line *)
escape           = "\n" | "\t" | "\r" | '\"' | "\\" | "\u{" , hex , { hex } , "}" ;
(* comments: // to end of line, and nestable /* ... */ *)

(* Tests, run by `orbit test` and never compiled into workflow IR.
   Values in `input`, `signal` and `expect ... output` must be constants;
   in `returns`, `input` is the mocked task's input. *)
test_decl        = "test" , STRING , "{" , { test_member , [ sep ] } , "}" ;
test_member      = "workflow" , [ ":" ] , IDENTIFIER
                 | "version" , [ ":" ] , STRING
                 | "input" , [ ":" ] , expression
                 | "mock" , STRING , mock_behaviour , { "times" , INTEGER , "then" , mock_behaviour }
                 | "signal" , IDENTIFIER , [ expression ]         (* object payload on the same line; default {} *)
                 | "expect" , expectation ;
mock_behaviour   = "returns" , expression
                 | "fails" , STRING , [ STRING ] , [ "retryable" ]   (* code, message *)
                 | "hangs" ;                                      (* never answers *)
expectation      = "status" , IDENTIFIER                          (* COMPLETED FAILED CANCELLED TIMED_OUT *)
                 | "output" , expression
                 | "error" , STRING
                 | "step" , IDENTIFIER , ( IDENTIFIER             (* a unit status, e.g. SKIPPED *)
                                         | "output" , expression
                                         | "attempts" , INTEGER )
                 | "compensated" , IDENTIFIER ;
