{
  "version": "2.0.0",
  "tasks": [
    { "label": "cargo build", "type": "shell", "command": "cargo build", "group": { "kind": "build", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "cargo test", "type": "shell", "command": "cargo test", "group": { "kind": "test", "isDefault": true }, "problemMatcher": ["$rustc"] },
    { "label": "clippy", "type": "shell", "command": "cargo clippy --all-targets -- -D warnings", "problemMatcher": ["$rustc"] },
    { "label": "e2e tests", "type": "shell", "command": "cargo build && python3 -I tests/e2e/test_e2e.py", "group": "test", "problemMatcher": [] },
    { "label": "all checks", "type": "shell", "command": "./scripts/check.sh", "group": "test", "problemMatcher": ["$rustc"] },
    { "label": "orbit server", "type": "shell", "command": "cargo run -- server --db .orbit/dev.db", "isBackground": true, "problemMatcher": [] },
    { "label": "example workers", "type": "shell", "command": "PYTHONPATH=sdks/python python3 examples/workers/python/order_workers.py & node examples/workers/typescript/order_workers.ts; wait", "isBackground": true, "problemMatcher": [] },
    { "label": "orbit check (current file)", "type": "shell", "command": "cargo run -q -- check ${file}", "problemMatcher": [] },
    { "label": "build VS Code extension", "type": "shell", "command": "npm install && npm run compile", "options": { "cwd": "${workspaceFolder}/editors/vscode" }, "problemMatcher": ["$tsc"] }
  ]
}
